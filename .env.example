PORT=3456
HOST=127.0.0.1

PRIMARY_BASE_URL=http://127.0.0.1:8080/v1
PRIMARY_MODEL=reasoning-model
PRIMARY_API_KEY=
PRIMARY_TIMEOUT_MS=900000
PRIMARY_PRESERVE_THINKING=true

CONDENSATION_ENABLED=true
CONDENSATION_SMOKE_TAG_ENABLED=false
CONDENSER_BASE_URL=http://127.0.0.1:8081/v1
CONDENSER_MODEL=condensation-model
CONDENSER_API_KEY=
CONDENSER_TIMEOUT_MS=180000
CONDENSER_ENABLE_THINKING=true
CONDENSER_REASONING_EFFORT=low
CONDENSER_MAX_OUTPUT_TOKENS=4096
UPSTREAM_REASONING_REPLAY_MODE=reasoning_content
CONDENSE_MIN_REASONING_TOKENS=512
CONDENSE_COMPLETED_MAX_TOKENS=768
CONDENSE_COMPLETED_RATIO=0.15
CONDENSE_TOOL_MAX_TOKENS=1200
CONDENSE_TOOL_RATIO=0.35

# Optional. When set, original normalized turns are appended as JSON lines.
ARCHIVE_PATH=

# Optional shared secret expected from Claude Code as x-api-key or a Bearer token.
PROXY_API_KEY=

# Used for visible usage estimates returned to Claude Code. Actual upstream usage
# remains available in logs and x-rcr-* response headers.
ESTIMATED_CHARACTERS_PER_TOKEN=3.5
MAX_REQUEST_BYTES=10485760
