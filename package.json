{
  "name": "reasoning-condenser",
  "version": "0.1.0",
  "private": true,
  "description": "A protocol-compatible proxy that condenses preserved model reasoning before coding agents store it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangxiubo/reasoning-condenser.git"
  },
  "homepage": "https://github.com/zhangxiubo/reasoning-condenser#readme",
  "bugs": {
    "url": "https://github.com/zhangxiubo/reasoning-condenser/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "start:opencode-go": "bash scripts/start_opencode_go.sh",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/*.integration.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
