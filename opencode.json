{
  "$schema": "https://opencode.ai/config.json",
  "model": "rcr/deepseek-v4-flash",
  "provider": {
    "rcr": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Reasoning Condensation Router",
      "options": {
        "baseURL": "http://127.0.0.1:3456/v1",
        "apiKey": "dummy"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash through RCR",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  }
}
